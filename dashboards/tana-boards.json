          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (tool) (increase(tana_boards_tool_calls_total{instance=~\"$instance\"}[24h]))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
