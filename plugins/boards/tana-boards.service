# tana-boards (the voice boards' server) as a systemd service. Adjust the paths and user to your install, then:
#   sudo cp tana-boards.service /etc/systemd/system/ && sudo systemctl enable --now tana-boards
[Unit]
Description=tana-boards: Tana's voice boards
After=network-online.target
Wants=network-online.target

[Service]
User=tana
WorkingDirectory=/opt/tana/plugins/boards
ExecStart=/opt/tana/server/.venv/bin/tana-boards -c /opt/tana/plugins/boards/config.yaml
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1

[Install]
WantedBy=multi-user.target
