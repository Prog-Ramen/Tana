+
+bool AudioService::RequestSonar(const SonarRequest& req,
+                                std::function<void(std::vector<int16_t>&&, int, int)> done) {
+    if (sonar_pending_.load() || !IsPlaybackIdle()) {
+        return false;
+    }
+    sonar_req_ = req;
+    sonar_done_ = std::move(done);
+    sonar_pending_.store(true);
+    return true;
+}
+
+void AudioService::RunSonar() {
+    auto done = std::move(sonar_done_);
+    const auto req = sonar_req_;
+    int rate = codec_->input_sample_rate();
+    if (rate < 44100 || codec_->output_sample_rate() != rate) {
+        ESP_LOGW(TAG, "Sonar needs a 44.1/48 kHz codec (input %d, output %d)", rate, codec_->output_sample_rate());
+        if (done) done({}, rate, 0);
+        return;
+    }
+    const int period = rate * req.period_ms / 1000;
+    const int chirp = rate * req.chirp_ms / 1000;
+
+    // One period: Hann-windowed linear sweep, then silence
+    struct Play {
+        AudioCodec* codec;
+        std::vector<int16_t> frame;
+        int repeats;
+        SemaphoreHandle_t finished;
+    };
+    auto* play = new Play{codec_, std::vector<int16_t>(period, 0), req.repeats, xSemaphoreCreateBinary()};
+    for (int i = 0; i < chirp; i++) {
+        float t = float(i) / rate;
+        float T = float(chirp) / rate;
+        float phase = 2 * float(M_PI) * (req.f0 * t + (req.f1 - req.f0) * t * t / (2 * T));
+        float w = 0.5f - 0.5f * std::cos(2 * float(M_PI) * i / (chirp - 1));
+        play->frame[i] = int16_t(req.amplitude * w * std::sin(phase));
+    }
+
+    if (!codec_->output_enabled()) codec_->EnableOutput(true);
+    if (!codec_->input_enabled()) codec_->EnableInput(true);
+    const int ch = req.all_channels ? codec_->SetCaptureAllChannels(true) : codec_->input_channels();
+
+    xTaskCreate(
+        [](void* arg) {
+            auto* p = static_cast<Play*>(arg);
+            for (int r = 0; r < p->repeats; r++) {
+                p->codec->OutputData(p->frame);
+            }
+            xSemaphoreGive(p->finished);
+            vTaskDelete(nullptr);
+        },
+        "sonar_play", 3072, play, 9, nullptr);
+
+    // Capture repeats+1 periods in small chunks; skip the first period, sum the rest by position
+    std::vector<int32_t> acc(period * ch, 0);
+    const int chunk = period / 8 > 0 ? period / 8 : period;
+    std::vector<int16_t> block(chunk * ch);
+    int summed = 0;
+    for (int r = 0; r <= req.repeats; r++) {
+        bool ok = true;
+        for (int off = 0; off < period; off += chunk) {
+            int n = std::min(chunk, period - off);
+            block.resize(n * ch);
+            if (!codec_->InputData(block)) { ok = false; break; }
+            if (r == 0) continue;
+            for (int i = 0; i < n * ch; i++) acc[off * ch + i] += block[i];
+        }
+        if (!ok) break;
+        if (r > 0) summed++;
+    }
+    xSemaphoreTake(play->finished, pdMS_TO_TICKS(req.repeats * req.period_ms + 2000));
+    vSemaphoreDelete(play->finished);
+    delete play;
+    if (req.all_channels) codec_->SetCaptureAllChannels(false);
+
+    // Average in place, then hand back channel-major int16 data (ch blocks of `period` samples)
+    std::vector<int16_t> avg(period * ch);
+    for (int c = 0; c < ch; c++) {
+        for (int i = 0; i < period; i++) {
+            avg[c * period + i] = summed ? int16_t(acc[i * ch + c] / summed) : 0;
+        }
+    }
+    acc.clear();
+    acc.shrink_to_fit();
+    ESP_LOGI(TAG, "Sonar: %d periods x %d samples x %d ch at %d Hz", summed, period, ch, rate);
+    audio_input_need_warmup_.store(true);
+    if (done) done(std::move(avg), rate, period);
+}
