+
+int BoxAudioCodec::SetCaptureAllChannels(bool all) {
+    // Reopen the ES7210 with all four TDM slots (MIC1, MIC3, MIC2, MIC4) for sonar, or restore
+    // the normal single-microphone (+reference) layout.
+    std::lock_guard<std::mutex> lock(data_if_mutex_);
+    if (input_enabled_) {
+        esp_codec_dev_close(input_dev_);
+    }
+    esp_codec_dev_sample_info_t fs = {
+        .bits_per_sample = 16,
+        .channel = 4,
+        .channel_mask = ESP_CODEC_DEV_MAKE_CHANNEL_MASK(0),
+        .sample_rate = (uint32_t)input_sample_rate_,
+        .mclk_multiple = 0,
+    };
+    if (all) {
+        fs.channel_mask = 0x0F;
+    } else if (input_reference_) {
+        fs.channel_mask |= ESP_CODEC_DEV_MAKE_CHANNEL_MASK(1);
+    }
+    esp_codec_dev_open(input_dev_, &fs);
+    esp_codec_dev_set_in_channel_gain(input_dev_, all ? 0x0F : ESP_CODEC_DEV_MAKE_CHANNEL_MASK(0), input_gain_);
+    if (!all && input_reference_ && reference_gain_channel_ >= 0) {
+        esp_codec_dev_set_in_channel_gain(input_dev_, ESP_CODEC_DEV_MAKE_CHANNEL_MASK(reference_gain_channel_),
+                                          reference_gain_);
+    }
+    input_enabled_ = true;
+    return all ? 4 : input_channels_;
+}
