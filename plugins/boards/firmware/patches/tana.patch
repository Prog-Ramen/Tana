+#if CONFIG_TANA_AMBIENT_LISTENING
+void Application::TanaTick() {
+    auto state = GetDeviceState();
+    auto& board = Board::GetInstance();
+
+    // Keep the voice channel open: reconnect with exponential backoff while idle
+    if (state == kDeviceStateIdle && protocol_ && clock_ticks_ >= tana_reconnect_delay_) {
+        tana_auto_connecting_ = true;
+        tana_reconnect_delay_ = std::min(tana_reconnect_delay_ * 2, 60);
+        SetDeviceState(kDeviceStateConnecting);
+        Schedule([this]() { ContinueOpenAudioChannel(kListeningModeAutoStop); });
+        return;
+    }
+
+    // Dim the AMOLED while dormant to save power and avoid burn-in
+    auto backlight = board.GetBacklight();
+    if (state == kDeviceStateListening && !tana_awake_) {
+        tana_dormant_ticks_++;
+        if (CONFIG_TANA_DIM_AFTER_SECONDS > 0 && !tana_dimmed_ && backlight &&
+            tana_dormant_ticks_ >= CONFIG_TANA_DIM_AFTER_SECONDS) {
+            backlight->SetBrightness(CONFIG_TANA_DIM_BRIGHTNESS);
+            tana_dimmed_ = true;
+        }
+    } else {
+        tana_dormant_ticks_ = 0;
+        if (tana_dimmed_ && backlight) {
+            backlight->RestoreBrightness();
+            tana_dimmed_ = false;
+        }
+    }
+}
+
+void Application::TanaSetAwake(bool awake) {
+    bool changed = awake != tana_awake_;
+    if (!changed) {
+        return;
+    }
+    tana_awake_ = awake;
+    tana_dormant_ticks_ = 0;
+    if (awake && tana_dimmed_) {
+        if (auto backlight = Board::GetInstance().GetBacklight()) {
+            backlight->RestoreBrightness();
+        }
+        tana_dimmed_ = false;
+    }
+    if (GetDeviceState() == kDeviceStateListening) {
+        TanaUpdateListeningUi();
+        if (awake) {
+            audio_service_.PlaySound(Lang::Sounds::OGG_POPUP);
+        }
+    }
+}
+
+void Application::TanaUpdateListeningUi() {
+    auto display = Board::GetInstance().GetDisplay();
+    if (tana_awake_) {
+        display->SetStatus(Lang::Strings::LISTENING);
+        display->SetEmotion("neutral");
+    } else {
+        display->SetStatus("Say \"Hey Tana\"");
+        display->SetEmotion("sleepy");
+    }
+}
+#endif
