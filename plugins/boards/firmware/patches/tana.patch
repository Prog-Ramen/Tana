index 0000000..68c8fce
--- /dev/null
+++ b/main/tana_sense.cc
@@ -0,0 +1,423 @@
+#include "tana_sense.h"
+
+#include <cmath>
+#include <cstring>
+
+#include <esp_log.h>
+#include <esp_netif.h>
+#include <esp_timer.h>
+#include <esp_wifi.h>
+#include <freertos/FreeRTOS.h>
+#include <lwip/ip_addr.h>
+#include <ping/ping_sock.h>
+#include <soc/soc_caps.h>
+#include <freertos/queue.h>
+#include <lwip/sockets.h>
+
+#define TAG "TanaSense"
+
+namespace {
+
+constexpr int kMaxSubcarriers = 256;  // HE20 (Wi-Fi 6) CSI carries 256 bins, 242 active
+constexpr float kBaselineAlpha = 0.02f;  // ~2.5 s at 20 packets/s
+constexpr int G = TanaSenseReport::kProfileGroups;
+constexpr int S = TanaSenseReport::kSeriesRate;
+
+uint8_t g_bssid[6];
+float g_baseline[kMaxSubcarriers];
+int g_baseline_n = 0;  // active subcarriers in the baseline (0 = not initialised)
+int64_t g_last_he_us = 0;  // last time a Wi-Fi 6 frame arrived; older formats are skipped meanwhile
+int64_t g_tick_start_us = 0;
+
+// Work buffers for the CSI callback (it always runs in the Wi-Fi task, one frame at a time)
+float g_amp[kMaxSubcarriers];
+float g_phase[kMaxSubcarriers];
+int g_bin[kMaxSubcarriers];
+
+// Raw CSI streaming (RuView ADR-018 frames) via a small sender task
+struct RawFrame {
+    uint16_t len;
+    uint8_t data[20 + 384];
+};
+QueueHandle_t g_raw_queue = nullptr;
+volatile bool g_raw_enabled = false;
+uint8_t g_raw_node = 1;
+uint32_t g_raw_seq = 0;
+struct sockaddr_in g_raw_dest;
+
+void QueueRawFrame(const wifi_csi_info_t* info, int format) {
+    if (!g_raw_enabled || g_raw_queue == nullptr) return;
+    static RawFrame f;  // Wi-Fi task only
+    uint16_t iq = info->len;
+    if (iq > sizeof(f.data) - 20) iq = sizeof(f.data) - 20;
+    uint32_t magic = 0xC5110001;
+    uint16_t nsub = iq / 2;
+    int ch = info->rx_ctrl.channel;
+    uint32_t freq = (ch >= 1 && ch <= 13) ? 2412 + (ch - 1) * 5 : (ch == 14 ? 2484 : 0);
+    uint32_t seq = g_raw_seq++;
+    memcpy(&f.data[0], &magic, 4);
+    f.data[4] = g_raw_node;
+    f.data[5] = 1;  // antennas
+    memcpy(&f.data[6], &nsub, 2);
+    memcpy(&f.data[8], &freq, 4);
+    memcpy(&f.data[12], &seq, 4);
+    f.data[16] = (uint8_t)(int8_t)info->rx_ctrl.rssi;
+    f.data[17] = (uint8_t)(int8_t)info->rx_ctrl.noise_floor;
+    f.data[18] = format == 4 || format == 6 ? 1 : format == 5 ? 2 : format == 7 ? 3 : format >= 0 ? 0 : 0xFF;
+    f.data[19] = 0;
+    memcpy(&f.data[20], info->buf, iq);
+    if (info->first_word_invalid && iq >= 4) memset(&f.data[20], 0, 4);
+    f.len = 20 + iq;
+    xQueueSend(g_raw_queue, &f, 0);  // drop if the sender is behind
+}
+
+portMUX_TYPE g_lock = portMUX_INITIALIZER_UNLOCKED;
+struct {
+    float sum, max, rssi_sum, rssi_sq;
+    int n;
+    float profile[G];
+    float phase[G];
+    int profile_n;
+    float series[S][G];
+    float pseries[S][G];
+    int series_n[S];
+    int format_count[16];
+    int csi_len, active_bins;
+} g_acc;
+
+std::function<void(const TanaSenseReport&)> g_on_report;
+
+// Nearest-light probe state (only touched while a probe runs)
+constexpr int kMaxProbe = 8;
+struct ProbeSlot {
+    uint8_t mac[6];
+    float rssi_sum;
+    int n;
+};
+ProbeSlot g_probe[kMaxProbe];
+int g_probe_count = 0;
+
+void OnPromiscuous(void* buf, wifi_promiscuous_pkt_type_t type) {
+    auto* pkt = static_cast<wifi_promiscuous_pkt_t*>(buf);
+    if (pkt->rx_ctrl.sig_len < 24) return;
+    const uint8_t* transmitter = pkt->payload + 10;  // 802.11 header: addr2
+    for (int i = 0; i < g_probe_count; i++) {
+        if (memcmp(transmitter, g_probe[i].mac, 6) == 0) {
+            portENTER_CRITICAL(&g_lock);
+            g_probe[i].rssi_sum += pkt->rx_ctrl.rssi;
+            g_probe[i].n++;
+            portEXIT_CRITICAL(&g_lock);
+            return;
+        }
+    }
+}
+
+bool IsHe(int format) { return format >= 4 && format <= 7; }
+
+void OnCsi(void* ctx, wifi_csi_info_t* info) {
+    if (info == nullptr || info->buf == nullptr || memcmp(info->mac, g_bssid, 6) != 0) {
+        return;  // only the router's replies: a fixed transmitter makes the signal comparable
+    }
+#if SOC_WIFI_HE_SUPPORT
+    int format = info->rx_ctrl.cur_bb_format;
+#else
+    int format = -1;
+#endif
+    int64_t now = esp_timer_get_time();
+    if (IsHe(format)) {
+        g_last_he_us = now;
+    } else if (now - g_last_he_us < 2000000) {
+        return;  // Wi-Fi 6 frames are arriving: don't mix in coarser older-format ones
+    }
+
+    QueueRawFrame(info, format);
+
+    const int8_t* buf = info->buf;
+    int total = info->len / 2;
+    if (total > kMaxSubcarriers) total = kMaxSubcarriers;
+    // Non-HE frames pack several 64-bin training fields back to back (L-LTF, then HT-LTF); each
+    // block is in FFT order (0..31, then -32..-1). Use the last full 64-bin block (HT-LTF when
+    // present) and walk it from -32 to 31 so neighbouring bins really are neighbours. HE frames
+    // are one 256-bin field in the same FFT order.
+    int block = IsHe(format) ? total : 64;
+    if (total < block) block = total;
+    int base = (total / block - 1) * block;
+    int half = block / 2;
+
+    // Active subcarriers only (guard bands and DC come back as zeros)
+    int n = 0;
+    float mean = 0;
+    for (int s = -half; s < half; s++) {
+        int k = base + (s < 0 ? s + block : s);
+        if (k < 2 && info->first_word_invalid) continue;  // first 4 bytes unreliable
+        float im = buf[2 * k], re = buf[2 * k + 1];
+        if (im == 0 && re == 0) continue;
+        g_amp[n] = std::sqrt(re * re + im * im);
+        g_phase[n] = std::atan2(im, re);
+        g_bin[n] = s;  // true subcarrier index, for the phase fit
+        mean += g_amp[n];
+        n++;
+    }
+    if (n < 16) return;
+    mean /= n;
+    if (mean < 1.0f) return;
+
+    float dev = 0;
+    if (g_baseline_n != n) {
+        for (int k = 0; k < n; k++) g_baseline[k] = g_amp[k] / mean;
+        g_baseline_n = n;
+        return;
+    }
+    // Movement: compare the normalized profile to its slow-moving average
+    for (int k = 0; k < n; k++) {
+        float v = g_amp[k] / mean;
+        dev += std::fabs(v - g_baseline[k]);
+        g_baseline[k] += kBaselineAlpha * (v - g_baseline[k]);
+    }
+    dev /= n;
+
+    // Phase: unwrap across subcarriers, then remove the straight-line part (timing offset and
+    // clock error differ per packet and add a slope + constant); what remains is the channel.
+    for (int k = 1; k < n; k++) {
+        float d = g_phase[k] - g_phase[k - 1];
+        while (d > float(M_PI)) { g_phase[k] -= 2 * float(M_PI); d -= 2 * float(M_PI); }
+        while (d < -float(M_PI)) { g_phase[k] += 2 * float(M_PI); d += 2 * float(M_PI); }
+    }
+    float sx = 0, sy = 0, sxx = 0, sxy = 0;
+    for (int k = 0; k < n; k++) {
+        float x = g_bin[k], y = g_phase[k];
+        sx += x; sy += y; sxx += x * x; sxy += x * y;
+    }
+    float denom = n * sxx - sx * sx;
+    float slope = denom != 0 ? (n * sxy - sx * sy) / denom : 0;
+    float icpt = (sy - slope * sx) / n;
+
+    // Per-slice means
+    float amp_g[G] = {}, ph_g[G] = {};
+    int per = n / G;
+    for (int g = 0; g < G; g++) {
+        float sa = 0, sp = 0;
+        for (int k = g * per; k < (g + 1) * per; k++) {
+            sa += g_amp[k] / mean;
+            sp += g_phase[k] - (slope * g_bin[k] + icpt);
+        }
+        amp_g[g] = sa / per;
+        ph_g[g] = sp / per;
+    }
+
+    float rssi = info->rx_ctrl.rssi;
+    int slot = int((now - g_tick_start_us) / (1000000 / S));
+    if (slot < 0) slot = 0;
+    if (slot >= S) slot = S - 1;
+    portENTER_CRITICAL(&g_lock);
+    for (int g = 0; g < G; g++) {
+        g_acc.profile[g] += amp_g[g];
+        g_acc.phase[g] += ph_g[g];
+        g_acc.series[slot][g] += amp_g[g];
+        g_acc.pseries[slot][g] += ph_g[g];
+    }
+    g_acc.series_n[slot]++;
+    g_acc.profile_n++;
+    g_acc.sum += dev;
+    if (dev > g_acc.max) g_acc.max = dev;
+    g_acc.rssi_sum += rssi;
+    g_acc.rssi_sq += rssi * rssi;
+    g_acc.n++;
+    if (format >= 0 && format < 16) g_acc.format_count[format]++;
+    g_acc.csi_len = info->len;
+    g_acc.active_bins = n;
+    portEXIT_CRITICAL(&g_lock);
+}
+
+void OnTick(void*) {
+    static decltype(g_acc) acc;  // large; keep it off the timer task's stack
+    portENTER_CRITICAL(&g_lock);
+    acc = g_acc;
+    memset(&g_acc, 0, sizeof(g_acc));
+    g_tick_start_us = esp_timer_get_time();
+    portEXIT_CRITICAL(&g_lock);
+    if (acc.n == 0 || !g_on_report) return;
+    static TanaSenseReport r;
+    r.motion = acc.sum / acc.n;
+    r.motion_max = acc.max;
+    r.rssi = acc.rssi_sum / acc.n;
+    float var = acc.rssi_sq / acc.n - r.rssi * r.rssi;
+    r.rssi_std = var > 0 ? std::sqrt(var) : 0;
+    r.packets = acc.n;
+    r.format = -1;
+    int best = 0;
+    for (int f = 0; f < 16; f++) {
+        if (acc.format_count[f] > best) { best = acc.format_count[f]; r.format = f; }
+    }
+    r.csi_len = acc.csi_len;
+    r.active_bins = acc.active_bins;
+    for (int g = 0; g < G; g++) {
+        r.profile[g] = acc.profile_n ? acc.profile[g] / acc.profile_n : 0;
+        r.phase[g] = acc.profile_n ? acc.phase[g] / acc.profile_n : 0;
+    }
+    for (int t = 0; t < S; t++) {
+        r.series_valid[t] = acc.series_n[t] > 0;
+        for (int g = 0; g < G; g++) {
+            r.series[t][g] = acc.series_n[t] ? acc.series[t][g] / acc.series_n[t] : 0;
+            r.pseries[t][g] = acc.series_n[t] ? acc.pseries[t][g] / acc.series_n[t] : 0;
+        }
+    }
+    g_on_report(r);
+}
+
+}  // namespace
+
+TanaSense& TanaSense::GetInstance() {
+    static TanaSense instance;
+    return instance;
+}
+
+void TanaSense::Start(std::function<void(const TanaSenseReport&)> on_report) {
+    if (started_) return;
+
+    wifi_ap_record_t ap;
+    esp_netif_ip_info_t ip;
+    esp_netif_t* netif = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    if (esp_wifi_sta_get_ap_info(&ap) != ESP_OK || netif == nullptr ||
+        esp_netif_get_ip_info(netif, &ip) != ESP_OK || ip.gw.addr == 0) {
+        ESP_LOGW(TAG, "Wi-Fi not ready; sensing not started");
+        return;
+    }
+    memcpy(g_bssid, ap.bssid, 6);
+    g_on_report = std::move(on_report);
+
+    wifi_csi_config_t csi = {};
+    csi.enable = 1;
+    csi.acquire_csi_legacy = 1;  // L-LTF from the ping replies
+    csi.acquire_csi_ht20 = 1;
+    csi.acquire_csi_su = 1;
+    ESP_ERROR_CHECK_WITHOUT_ABORT(esp_wifi_set_csi_config(&csi));
+    ESP_ERROR_CHECK_WITHOUT_ABORT(esp_wifi_set_csi_rx_cb(OnCsi, nullptr));
+    if (esp_wifi_set_csi(true) != ESP_OK) {
+        ESP_LOGE(TAG, "CSI not available");
+        return;
+    }
+
+    // Keep traffic flowing from the router: tiny pings, 20 per second
+    esp_ping_config_t cfg = ESP_PING_DEFAULT_CONFIG();
+    cfg.count = ESP_PING_COUNT_INFINITE;
+    cfg.interval_ms = 50;
+    cfg.timeout_ms = 1000;
+    cfg.data_size = 1;
+    cfg.task_stack_size = 2560;
+    ip_addr_set_ip4_u32(&cfg.target_addr, ip.gw.addr);
+    esp_ping_callbacks_t cbs = {};
+    esp_ping_handle_t ping;
+    if (esp_ping_new_session(&cfg, &cbs, &ping) != ESP_OK || esp_ping_start(ping) != ESP_OK) {
+        ESP_LOGE(TAG, "Could not start ping");
+        return;
+    }
+
+    const esp_timer_create_args_t timer_args = {
+        .callback = OnTick, .arg = nullptr, .dispatch_method = ESP_TIMER_TASK,
+        .name = "tana_sense", .skip_unhandled_events = true};
+    esp_timer_handle_t timer;
+    esp_timer_create(&timer_args, &timer);
+    esp_timer_start_periodic(timer, 1000 * 1000);
+    started_ = true;
+    ESP_LOGI(TAG, "Wi-Fi sensing started (gateway " IPSTR ")", IP2STR(&ip.gw));
+}
+
+void TanaSense::Probe(std::vector<ProbeTarget> targets, int seconds,
+                      std::function<void(const std::string&)> on_done) {
+    struct Job {
+        std::vector<ProbeTarget> targets;
+        int seconds;
+        std::function<void(const std::string&)> on_done;
+    };
+    auto* job = new Job{std::move(targets), seconds, std::move(on_done)};
+    xTaskCreate(
+        [](void* arg) {
+            auto* job = static_cast<Job*>(arg);
+            g_probe_count = 0;
+            for (auto& t : job->targets) {
+                if (g_probe_count >= kMaxProbe) break;
+                memcpy(g_probe[g_probe_count].mac, t.mac, 6);
+                g_probe[g_probe_count].rssi_sum = 0;
+                g_probe[g_probe_count].n = 0;
+                g_probe_count++;
+            }
+            wifi_promiscuous_filter_t filter = {.filter_mask = WIFI_PROMIS_FILTER_MASK_DATA};
+            esp_wifi_set_promiscuous_filter(&filter);
+            esp_wifi_set_promiscuous_rx_cb(OnPromiscuous);
+            esp_wifi_set_promiscuous(true);
+
+            // Each light answers our pings by transmitting to the router; we overhear that.
+            std::vector<esp_ping_handle_t> pings;
+            for (int i = 0; i < g_probe_count; i++) {
+                esp_ping_config_t cfg = ESP_PING_DEFAULT_CONFIG();
+                cfg.count = job->seconds * 10;
+                cfg.interval_ms = 100;
+                cfg.data_size = 1;
+                cfg.task_stack_size = 2560;
+                ip_addr_t addr;
+                if (!ipaddr_aton(job->targets[i].ip.c_str(), &addr)) continue;
+                cfg.target_addr = addr;
+                esp_ping_callbacks_t cbs = {};
+                esp_ping_handle_t h;
+                if (esp_ping_new_session(&cfg, &cbs, &h) == ESP_OK && esp_ping_start(h) == ESP_OK) {
+                    pings.push_back(h);
+                }
+            }
+            vTaskDelay(pdMS_TO_TICKS(job->seconds * 1000 + 500));
+            esp_wifi_set_promiscuous(false);
+            for (auto h : pings) {
+                esp_ping_stop(h);
+                esp_ping_delete_session(h);
+            }
+
+            std::string json = "{";
+            for (int i = 0; i < g_probe_count; i++) {
+                char item[96];
+                const uint8_t* m = g_probe[i].mac;
+                float rssi = g_probe[i].n ? g_probe[i].rssi_sum / g_probe[i].n : -127;
+                snprintf(item, sizeof(item), "%s\"%02x:%02x:%02x:%02x:%02x:%02x\":{\"rssi\":%.1f,\"n\":%d}",
+                         i ? "," : "", m[0], m[1], m[2], m[3], m[4], m[5], rssi, g_probe[i].n);
+                json += item;
+            }
+            json += "}";
+            g_probe_count = 0;
+            ESP_LOGI(TAG, "Probe result: %s", json.c_str());
+            job->on_done(json);
+            delete job;
+            vTaskDelete(nullptr);
+        },
+        "tana_probe", 4096, job, 3, nullptr);
+}
+
+void TanaSense::StreamRaw(const std::string& host, int port, int node_id) {
+    if (host.empty()) {
+        g_raw_enabled = false;
+        ESP_LOGI(TAG, "Raw CSI stream off");
+        return;
+    }
+    memset(&g_raw_dest, 0, sizeof(g_raw_dest));
+    g_raw_dest.sin_family = AF_INET;
+    g_raw_dest.sin_port = htons(port);
+    if (inet_pton(AF_INET, host.c_str(), &g_raw_dest.sin_addr) != 1) {
+        ESP_LOGW(TAG, "Bad stream host %s", host.c_str());
+        return;
+    }
+    g_raw_node = node_id;
+    if (g_raw_queue == nullptr) {
+        g_raw_queue = xQueueCreate(6, sizeof(RawFrame));
+        xTaskCreate(
+            [](void*) {
+                int sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+                static RawFrame f;
+                while (true) {
+                    if (xQueueReceive(g_raw_queue, &f, portMAX_DELAY) == pdTRUE && g_raw_enabled && sock >= 0) {
+                        sendto(sock, f.data, f.len, 0, (struct sockaddr*)&g_raw_dest, sizeof(g_raw_dest));
+                    }
+                }
+            },
+            "csi_udp", 3072, nullptr, 3, nullptr);
+    }
+    g_raw_enabled = true;
+    ESP_LOGI(TAG, "Raw CSI stream to %s:%d (node %d)", host.c_str(), port, node_id);
+}
diff --git a/main/tana_sense.h b/main/tana_sense.h
new file mode 100644
index 0000000..299319e
--- /dev/null
+++ b/main/tana_sense.h
@@ -0,0 +1,62 @@
+#ifndef TANA_SENSE_H
+#define TANA_SENSE_H
+
+#include <functional>
+#include <string>
+#include <vector>
+
+// Wi-Fi sensing for presence detection.
+//
+// Pings the gateway ~20 times a second so the router keeps answering, captures the channel
+// state information (CSI) of those replies, and measures how much the per-subcarrier amplitude
+// profile wobbles compared to its recent average. People moving in the room change the
+// multipath, which shows up as wobble. Once a second the callback gets a motion score plus the
+// RSSI spread; deciding "occupied" (and calibrating per room) happens on the server.
+struct TanaSenseReport {
+    static constexpr int kProfileGroups = 16;  // channel slices
+    static constexpr int kSeriesRate = 10;     // samples per second in `series`
+
+    float motion;      // mean normalized amplitude deviation (unitless, ~0.01 still … 0.1+ moving)
+    float motion_max;  // largest single-packet deviation in the second
+    float rssi;        // mean RSSI (dBm)
+    float rssi_std;    // RSSI standard deviation (dB)
+    int packets;       // CSI frames used
+    int format;        // dominant frame format (wifi_rx_bb_format_t: 1 11g, 2 HT, 4 HE SU, ...; -1 unknown)
+    int csi_len;       // CSI buffer length of those frames (bytes)
+    int active_bins;   // subcarriers with data
+    // Signal "shape": mean normalized amplitude per channel slice over the second
+    float profile[kProfileGroups];
+    // Same slices, residual phase after removing the per-packet timing/clock slope (radians)
+    float phase[kProfileGroups];
+    // Normalized amplitude per slice at kSeriesRate Hz, for slow rhythms like breathing
+    float series[kSeriesRate][kProfileGroups];
+    // Residual phase per slice at kSeriesRate Hz (millimetre movement such as breathing)
+    float pseries[kSeriesRate][kProfileGroups];
+    int series_valid[kSeriesRate];
+};
+
+class TanaSense {
+public:
+    static TanaSense& GetInstance();
+    // Starts once the station is connected; safe to call more than once.
+    void Start(std::function<void(const TanaSenseReport&)> on_report);
+
+    // Nearest-light probe: ping each target for `seconds` while overhearing the targets' own
+    // transmissions (promiscuous mode, frames whose transmitter is the target), then report the
+    // mean RSSI per MAC as a JSON object, e.g. {"30:ed:a0:5f:f2:bc":{"rssi":-52.3,"n":31}}.
+    struct ProbeTarget {
+        std::string ip;
+        uint8_t mac[6];
+    };
+    void Probe(std::vector<ProbeTarget> targets, int seconds, std::function<void(const std::string&)> on_done);
+
+    // Also stream every raw CSI frame over UDP in RuView's ADR-018 format
+    // (magic 0xC5110001 header + I/Q bytes) to host:port; empty host stops it.
+    void StreamRaw(const std::string& host, int port, int node_id);
+
+private:
+    TanaSense() = default;
+    bool started_ = false;
+};
+
+#endif
