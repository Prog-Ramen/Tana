+#include "settings.h"
+
+#define TAG "TanaFallback"
+
+namespace {
+
+// SP530E command: "SPTECH\0" + [cmd,0,0,0] + payload length (2 bytes, big-endian) + payload
+struct LightCommand {
+    std::string ip;
+    bool on;
+};
+
+void LightTask(void* arg) {
+    auto* cmd = static_cast<LightCommand*>(arg);
+    uint8_t packet[14] = {'S', 'P', 'T', 'E', 'C', 'H', 0, 0x50, 0, 0, 0, 0, 1, (uint8_t)(cmd->on ? 1 : 0)};
+    for (int attempt = 0; attempt < 3; attempt++) {
+        int s = socket(AF_INET, SOCK_STREAM, IPPROTO_IP);
+        if (s < 0) break;
+        timeval tv = {.tv_sec = 4, .tv_usec = 0};
+        setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+        setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+        sockaddr_in addr = {};
+        addr.sin_family = AF_INET;
+        addr.sin_port = htons(8587);
+        inet_pton(AF_INET, cmd->ip.c_str(), &addr.sin_addr);
+        bool ok = connect(s, (sockaddr*)&addr, sizeof(addr)) == 0 && send(s, packet, sizeof(packet), 0) == sizeof(packet);
+        vTaskDelay(pdMS_TO_TICKS(300));  // the controller needs a moment before the connection closes
+        close(s);
+        if (ok) {
+            ESP_LOGI(TAG, "light %s %s", cmd->ip.c_str(), cmd->on ? "on" : "off");
+            break;
+        }
+        ESP_LOGW(TAG, "light %s unreachable (attempt %d)", cmd->ip.c_str(), attempt + 1);
+        vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+    delete cmd;
+    vTaskDelete(nullptr);
+}
+
+float Clamp6(float v) { return std::min(v, 6.0f); }
+
+}  // namespace
+
+void TanaFallback::Load() {
+    Settings settings("tana_fb", false);
+    auto json = settings.GetString("kit");
+    last_kit_us_ = 1;  // counts as "heard at boot": the board takes over only after 3 min without a kit
+    // Its own clock from the internet, so it knows day from night even if the server is down at boot
+    if (!esp_sntp_enabled()) {
+        esp_sntp_setoperatingmode(ESP_SNTP_OPMODE_POLL);
+        esp_sntp_setservername(0, "pool.ntp.org");
+        esp_sntp_setservername(1, "time.google.com");
+        esp_sntp_init();
+    }
+    if (!json.empty() && Parse(json)) {
+        ESP_LOGI(TAG, "fallback kit loaded (light %s, %d dark periods, %d scheduled)", light_ip_.c_str(), dark_count_,
+                 schedule_count_);
+    }
+}
+
+void TanaFallback::Configure(const std::string& json) {
+    if (!Parse(json)) {
+        return;
+    }
+    last_kit_us_ = esp_timer_get_time();
+    // The fingerprints drift a little every minute: save to flash at most hourly (spares the flash)
+    if (last_save_us_ == 0 || last_kit_us_ - last_save_us_ > 3600LL * 1000000) {
+        Settings settings("tana_fb", true);
+        settings.SetString("kit", json);
+        last_save_us_ = last_kit_us_;
+    }
+}
+
+bool TanaFallback::Parse(const std::string& json) {
+    cJSON* root = cJSON_Parse(json.c_str());
+    if (!root) return false;
+    bool ok = false;
+    auto ip = cJSON_GetObjectItem(root, "light_ip");
+    auto dark = cJSON_GetObjectItem(root, "dark");
+    auto empty = cJSON_GetObjectItem(root, "empty");
+    auto schedule = cJSON_GetObjectItem(root, "schedule");
+    if (cJSON_IsString(ip) && (cJSON_IsObject(empty) || cJSON_IsArray(schedule))) {
+        light_ip_ = ip->valuestring;
+        dark_count_ = 0;
+        cJSON* p;
+        if (cJSON_IsArray(dark)) cJSON_ArrayForEach(p, dark) {
+            if (dark_count_ >= kMaxDark || cJSON_GetArraySize(p) != 2) break;
+            dark_[dark_count_][0] = (long)cJSON_GetArrayItem(p, 0)->valuedouble;
+            dark_[dark_count_][1] = (long)cJSON_GetArrayItem(p, 1)->valuedouble;
+            dark_count_++;
+        }
+        auto lat = cJSON_GetObjectItem(root, "lat");
+        auto lon = cJSON_GetObjectItem(root, "lon");
+        auto offset = cJSON_GetObjectItem(root, "dark_offset_minutes");
+        has_location_ = cJSON_IsNumber(lat) && cJSON_IsNumber(lon);
+        if (has_location_) {
+            lat_ = lat->valuedouble;
+            lon_ = lon->valuedouble;
+        }
+        dark_offset_min_ = cJSON_IsNumber(offset) ? offset->valueint : 0;
+        auto from = cJSON_GetObjectItem(root, "allowed_from");
+        auto until = cJSON_GetObjectItem(root, "allowed_until");
+        auto tz = cJSON_GetObjectItem(root, "tz_offset_minutes");
+        allowed_from_ = cJSON_IsNumber(from) ? from->valueint : -1;
+        allowed_until_ = cJSON_IsNumber(until) ? until->valueint : -1;
+        tz_offset_min_ = cJSON_IsNumber(tz) ? tz->valueint : 0;
+        auto read_print = [&](cJSON* o, int which) {
+            auto mean = cJSON_GetObjectItem(o, "mean");
+            if (!cJSON_IsArray(mean) || cJSON_GetArraySize(mean) < kGroups) return false;
+            for (int k = 0; k < kGroups; k++) mean_[which][k] = (float)cJSON_GetArrayItem(mean, k)->valuedouble;
+            spread_[which] = std::max(1e-6f, (float)cJSON_GetObjectItem(o, "spread")->valuedouble);
+            rssi_med_[which] = (float)cJSON_GetObjectItem(o, "rssi")->valuedouble;
+            rssi_spread_[which] = std::max(1e-6f, (float)cJSON_GetObjectItem(o, "rssi_spread")->valuedouble);
+            return true;
+        };
+        has_empty_ = cJSON_IsObject(empty) && read_print(empty, 0);
+        auto occ = cJSON_GetObjectItem(root, "occupied");
+        has_occupied_ = has_empty_ && cJSON_IsObject(occ) && read_print(occ, 1);
+        schedule_count_ = 0;
+        if (cJSON_IsArray(schedule)) cJSON_ArrayForEach(p, schedule) {
+            if (schedule_count_ >= kMaxSchedule || cJSON_GetArraySize(p) != 2) break;
+            schedule_[schedule_count_][0] = (long)cJSON_GetArrayItem(p, 0)->valuedouble;
+            schedule_[schedule_count_][1] = (long)cJSON_GetArrayItem(p, 1)->valuedouble;
+            schedule_count_++;
+        }
+        ok = has_empty_ || schedule_count_ > 0;
+        auto enter = cJSON_GetObjectItem(root, "shape_enter");
+        if (cJSON_IsNumber(enter)) shape_enter_ = (float)enter->valuedouble;
+        auto margin = cJSON_GetObjectItem(root, "exit_margin");
+        if (cJSON_IsNumber(margin)) exit_margin_ = (float)margin->valuedouble;
+    }
+    cJSON_Delete(root);
+    configured_ = configured_ || ok;
+    return ok;
+}
+
+bool TanaFallback::Active() const {
+    if (!configured_) return false;
+    return esp_timer_get_time() - last_kit_us_ > (int64_t)kHeartbeatTimeout * 1000000;
+}
+
+// NOAA sunrise/sunset (within ~3 min of the server's astral library), as UTC epochs
+// for the given UTC date; times past midnight UTC simply run into the next day.
+void TanaFallback::SunTimes(long day_start_utc, int doy, double lat, double lon, long* rise, long* set) {
+    double g = 2 * M_PI / 365 * (doy - 1);
+    double eq = 229.18 * (0.000075 + 0.001868 * cos(g) - 0.032077 * sin(g) - 0.014615 * cos(2 * g) - 0.040849 * sin(2 * g));
+    double de = 0.006918 - 0.399912 * cos(g) + 0.070257 * sin(g) - 0.006758 * cos(2 * g) + 0.000907 * sin(2 * g)
+                - 0.002697 * cos(3 * g) + 0.00148 * sin(3 * g);
+    double la = lat * M_PI / 180;
+    double c = cos(90.833 * M_PI / 180) / (cos(la) * cos(de)) - tan(la) * tan(de);
+    double ha = acos(std::max(-1.0, std::min(1.0, c))) * 180 / M_PI;
+    *rise = day_start_utc + (long)((720 - 4 * (lon + ha) - eq) * 60);
+    *set = day_start_utc + (long)((720 - 4 * (lon - ha) - eq) * 60);
+}
+
+bool TanaFallback::IsDark(long now) const {
+    if (now < 1700000000) return true;  // clock not set yet: don't let that block the light
+    if (allowed_from_ >= 0 && allowed_until_ >= 0) {
+        // the user's hours, e.g. nothing switches on after 11 PM
+        long local = now + tz_offset_min_ * 60;
+        int m = (int)((local % 86400 + 86400) % 86400 / 60);
+        bool inside = allowed_from_ <= allowed_until_ ? (m >= allowed_from_ && m < allowed_until_)
+                                                     : (m >= allowed_from_ || m < allowed_until_);
+        if (!inside) return false;
+    }
+    if (has_location_) {
+        for (int d = -1; d <= 1; d++) {     // daylight periods of yesterday, today and tomorrow (UTC dates)
+            time_t t = now + d * 86400;
+            tm u;
+            gmtime_r(&t, &u);
+            long day_start = (long)t - (u.tm_hour * 3600 + u.tm_min * 60 + u.tm_sec);
+            long rise, set;
+            SunTimes(day_start, u.tm_yday + 1, lat_, lon_, &rise, &set);
+            if (now >= rise && now < set + dark_offset_min_ * 60) return false;
+        }
+        return true;
+    }
+    for (int i = 0; i < dark_count_; i++) {
+        if (now >= dark_[i][0] && now < dark_[i][1]) return true;
+    }
+    return false;
+}
+
+// A timetable light: switched only at its on/off moments (a switch by hand in between sticks).
+void TanaFallback::RunSchedule(long now) {
+    if (schedule_count_ == 0 || now < 1700000000) return;   // no timetable, or the clock isn't set yet
+    if (schedule_checked_ == 0) schedule_checked_ = now;    // taking over: act from now on, not on the past
+    for (int i = 0; i < schedule_count_; i++) {
+        for (int which = 0; which < 2; which++) {
+            long t = schedule_[i][which];
+            if (schedule_checked_ < t && t <= now) {
+                ESP_LOGI(TAG, "timetable: light %s", which == 0 ? "on" : "off");
+                SwitchLight(which == 0);
+            }
+        }
+    }
+    schedule_checked_ = now;
+}
+
+void TanaFallback::SwitchLight(bool on) {
+    if (light_ip_.empty()) return;
+    auto* cmd = new LightCommand{light_ip_, on};
+    if (xTaskCreate(LightTask, "tana_light", 4096, cmd, 3, nullptr) != pdPASS) {
+        delete cmd;
+    }
+}
+
+// Same distances as the server (tana/occupancy.py _distance): shape = mean |cur - mean| / spread,
+// capped at 6; with signal strength, the average of the shape and |rssi - median| / spread terms.
+float TanaFallback::ShapeZ(const float* cur, const float* mean, float spread) const {
+    float d = 0;
+    for (int k = 0; k < kGroups; k++) d += fabsf(cur[k] - mean[k]);
+    return Clamp6(d / kGroups / spread);
+}
+
+float TanaFallback::BodyDistance(const float* shape, float rssi, int which) const {
+    float r = Clamp6(fabsf(rssi - rssi_med_[which]) / rssi_spread_[which]);
+    return (r + ShapeZ(shape, mean_[which], spread_[which])) / 2;
+}
+
+void TanaFallback::Feed(const TanaSenseReport& r) {
+    bool active = Active();
+    if (active != was_active_) {
+        if (active) {
+            ESP_LOGW(TAG, "server silent: fallback light control ON");
+        } else {
+            ESP_LOGI(TAG, "server back: fallback light control OFF");
+        }
+        was_active_ = active;
+        schedule_checked_ = 0;
+        occupied_ = false;  // unknown on takeover; entering or leaving switches the light
+        pending_entry_us_ = 0;
+        entry_hits_ = exit_hits_ = 0;
+    }
+    // keep the last 5 s of signal and the movement baseline even while the server is in charge
+    memcpy(recent_[recent_i_], r.profile, sizeof(recent_[0]));
+    recent_rssi_[recent_i_] = r.rssi;
+    recent_i_ = (recent_i_ + 1) % 5;
+    recent_n_ = std::min(recent_n_ + 1, 5);
+    int64_t now_us = esp_timer_get_time();
+    bool burst = r.motion_max > std::max(0.11f, 2.0f * quiet_peak_);
+    if (burst) {
+        burst_times_[0] = burst_times_[1];
+        burst_times_[1] = burst_times_[2];
+        burst_times_[2] = now_us;
+    } else {
+        quiet_peak_ += (r.motion_max - quiet_peak_) / 120.0f;
+    }
+    if (!active) return;
+    RunSchedule((long)time(nullptr));
+    if (!has_empty_ || recent_n_ < 5) return;
+
+    float cur[kGroups] = {};
+    float rssi = 0;
+    for (int i = 0; i < 5; i++) {
+        for (int k = 0; k < kGroups; k++) cur[k] += recent_[i][k] / 5;
+        rssi += recent_rssi_[i] / 5;
+    }
+    long now = (long)time(nullptr);
+
+    if (!occupied_) {
+        // movement is only a precursor: the shape must leave the empty room's shape (3 s in a row)
+        bool strong = burst && burst_times_[0] && now_us - burst_times_[0] <= 15 * 1000000LL;
+        if (strong && !pending_entry_us_) pending_entry_us_ = now_us;
+        if (pending_entry_us_ && now_us - pending_entry_us_ > 120 * 1000000LL) {
+            pending_entry_us_ = 0;
+            entry_hits_ = 0;
+        }
+        if (!pending_entry_us_) return;
+        float z = ShapeZ(cur, mean_[0], spread_[0]);
+        entry_hits_ = z > shape_enter_ ? entry_hits_ + 1 : 0;
+        if (entry_hits_ >= 3) {
+            occupied_ = true;
+            pending_entry_us_ = 0;
+            entry_hits_ = exit_hits_ = 0;
+            ESP_LOGI(TAG, "occupied (shape %.1fx)%s", z, IsDark(now) ? ", light on" : " (daylight: light stays)");
+            if (IsDark(now)) SwitchLight(true);
+        }
+    } else if (has_occupied_) {
+        // left: within 60 s of movement, closer to the empty fingerprint than the occupied one
+        bool recent_burst = burst_times_[2] && now_us - burst_times_[2] <= 60 * 1000000LL;
+        float margin = BodyDistance(cur, rssi, 1) - BodyDistance(cur, rssi, 0);
+        exit_hits_ = (recent_burst && margin >= exit_margin_) ? exit_hits_ + 1 : 0;
+        if (exit_hits_ >= 3) {
+            occupied_ = false;
+            exit_hits_ = 0;
+            ESP_LOGI(TAG, "empty (margin %+.1f), light off", margin);
+            SwitchLight(false);
+        }
+    }
+}
diff --git a/main/tana_fallback.h b/main/tana_fallback.h
new file mode 100644
index 0000000..ef244bd
--- /dev/null
+++ b/main/tana_fallback.h
@@ -0,0 +1,84 @@
+#ifndef TANA_FALLBACK_H
+#define TANA_FALLBACK_H
+
+#include <string>
+
+#include "tana_sense.h"
+
+// Board-side fallback for the room light while the Tana server is unreachable.
+//
+// Two kinds of rooms: a light that follows occupancy (the kit carries learned fingerprints), and a light
+// on a daily timetable (the kit carries the next on/off times, "schedule"). A kit can carry either or both.
+//
+// The server normally decides occupancy and switches the lights. Every minute it sends this board
+// a "fallback kit" ({"type":"tana","fallback":{...}}): the light to control, the dark hours, and
+// the learned empty/occupied fingerprints (signal shape + strength). The kit doubles as a
+// heartbeat. If no kit arrives for kHeartbeatTimeout, the board runs the same entry/exit rules on
+// its own Wi-Fi measurements and switches the light directly (SP530E, TCP 8587). When kits arrive
+// again it stops and the server is in charge. The kit is kept in NVS, so it survives reboots.
+class TanaFallback {
+public:
+    static TanaFallback& GetInstance() {
+        static TanaFallback instance;
+        return instance;
+    }
+
+    void Load();                               // read the kit saved in NVS (boot)
+    void Configure(const std::string& json);   // a new kit from the server (also the heartbeat)
+    void Feed(const TanaSenseReport& r);       // once a second from TanaSense
+    bool Active() const;
+
+private:
+    TanaFallback() = default;
+    bool Parse(const std::string& json);
+    bool IsDark(long now) const;
+    static void SunTimes(long day_start_utc, int day_of_year, double lat, double lon, long* rise, long* set);
+    void SwitchLight(bool on);
+    void RunSchedule(long now);
+    float ShapeZ(const float* cur, const float* mean, float spread) const;
+    float BodyDistance(const float* shape, float rssi, int which) const;  // which: 0 empty, 1 occupied
+
+    static constexpr int kGroups = TanaSenseReport::kProfileGroups;
+    static constexpr int kHeartbeatTimeout = 180;  // seconds without a kit before taking over
+    static constexpr int kMaxDark = 32;
+    static constexpr int kMaxSchedule = 16;        // on/off pairs: two weeks of a daily timetable
+
+    bool configured_ = false;
+    int64_t last_kit_us_ = 0;
+    std::string light_ip_;
+    long dark_[kMaxDark][2] = {};
+    int dark_count_ = 0;
+    bool has_location_ = false;     // dark hours computed on the board from the location
+    double lat_ = 0, lon_ = 0;
+    int dark_offset_min_ = 0;
+    int allowed_from_ = -1, allowed_until_ = -1;  // local minutes of day (e.g. 720..1380 = until 11 PM)
+    int tz_offset_min_ = 0;
+    int64_t last_save_us_ = 0;
+    // fingerprints: [0] empty, [1] occupied
+    float mean_[2][kGroups] = {};
+    float spread_[2] = {1, 1};
+    float rssi_med_[2] = {};
+    float rssi_spread_[2] = {1, 1};
+    bool has_occupied_ = false;
+    bool has_empty_ = false;        // occupancy fingerprints present: the light follows the room
+    long schedule_[kMaxSchedule][2] = {};   // [on, off] UTC epochs of a timetable light
+    int schedule_count_ = 0;
+    long schedule_checked_ = 0;     // switch only at the moments themselves, like the server
+    float shape_enter_ = 4.0f;
+    float exit_margin_ = 1.0f;
+
+    // running state
+    bool occupied_ = false;
+    bool was_active_ = false;
+    float recent_[5][kGroups] = {};
+    float recent_rssi_[5] = {};
+    int recent_n_ = 0;
+    int recent_i_ = 0;
+    float quiet_peak_ = 0.06f;      // slow average of per-second movement peaks
+    int64_t burst_times_[3] = {};   // last three movement bursts (us)
+    int64_t pending_entry_us_ = 0;
+    int entry_hits_ = 0;
+    int exit_hits_ = 0;
+};
+
+#endif
